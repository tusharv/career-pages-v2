# Copy to `.env` and fill in values.

# Supabase (required for /api/companies and company pages)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (no trailing slash). Set on production so OAuth redirectTo matches
# Supabase “Redirect URLs”; avoids falling back to Supabase Site URL (e.g. localhost).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Service role: use only locally or in CI to run `npm run seed:companies` or `npm run upload:logos`. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Company logos are served from the public bucket `company-logos` when NEXT_PUBLIC_SUPABASE_URL is set (run `npm run upload:logos` after applying storage migration).

# Postmark (report flow)
POSTMARK_API_KEY=

# Comma-separated company name fragments for the easter egg
NEXT_PUBLIC_EASTER_EGG_COMPANIES=company1,company2,company3

# micro1 referral code powering /remote-jobs. Part of a public share link, not a
# secret. Leave unset to use the project default.
# MICRO1_REFERRAL_CODE=

# Outbound URLs for /tools pages. Leave unset to use official homepages.
# Scrimba is the exception: the default includes 20% off Pro.
# CURSOR_REFERRAL_URL=
# V0_REFERRAL_URL=
# SHADCN_REFERRAL_URL=
# SUPABASE_REFERRAL_URL=
# VERCEL_REFERRAL_URL=
# HACKTOBERFEST_REFERRAL_URL=
# SCRIMBA_REFERRAL_URL=https://scrimba.com/?via=u412d258

# Admin (optional UI hints only; real access is admin_allowlist in Supabase + RLS)
# ADMIN_EMAILS=tusharvaghela@gmail.com

# Supabase Auth: enable Google provider. In Dashboard → Authentication → URL configuration:
# - Set Site URL to your production origin (https://<your-production-domain>).
# - Under Redirect URLs, include both:
#   - http://localhost:3000/auth/callback
#   - https://<your-production-domain>/auth/callback
# If redirect still hits localhost, Site URL or Redirect URLs are wrong; set NEXT_PUBLIC_SITE_URL above.
